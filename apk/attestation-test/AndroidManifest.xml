<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.ethan.webadb.attestation"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Standard permissions - no special privileges required. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BootApplication"
        android:label="WebADB Attestation Probe"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoDisplay">

        <!-- Dummy LAUNCHER activity. The activity itself does nothing visible
             (Theme.NoDisplay + immediately finish), but its mere existence
             allows monkey to start the app process. Without a started
             process, Android 14+ silently drops broadcasts to installed
             receivers even with explicit component + user 0 flag.
        -->
        <activity
            android:name=".BootActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Broadcast receiver: triggered by
               adb shell am broadcast -a io.ethan.webadb.PROBE -n io.ethan.webadb.attestation/.ProbeReceiver
             Writes its findings to /data/local/tmp/webadb_attestation.json
        -->
        <receiver
            android:name=".ProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.ethan.webadb.PROBE" />
            </intent-filter>
        </receiver>

        <!-- ContentProvider probe entry point. The host site calls
             adb shell "content query" against this URI, which is
             guaranteed to instantiate this provider (and thus the app
             process) before returning, regardless of Android 14+
             background-app broadcast restrictions that have been
             blocking Activity launches silently for the user.
        -->
        <provider
            android:name=".BootProvider"
            android:authorities="io.ethan.webadb.attestation.provider"
            android:exported="true" />
    </application>
</manifest>
